{
  "name": "doc-softphone",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "cms:config": "node scripts/gen-cms-config.mjs",
    "start": "npm run start:ru",
    "build": "npm run build:ru",
    "serve": "docusaurus serve --dir build-ru",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations --locale ru",
    "write-heading-ids": "docusaurus write-heading-ids",
    "prebuild:ru": "node scripts/prepare-ru.mjs",
    "build:ru": "docusaurus build --config docusaurus.config.ru.js --out-dir build-ru",
    "postbuild:ru": "node scripts/finish-ru.mjs",
    "start:ru": "node scripts/prepare-ru.mjs && docusaurus start --config docusaurus.config.ru.js"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
