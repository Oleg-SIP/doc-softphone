---
/* The body of the home page, in every language: what the documentation
   covers and where to start. The words are the documentation's own
   (src/content/i18n/<lang>.json) and the product site's
   (src/data/site/<lang>.json). Links are relative, so they work under
   any language prefix and any base path. */
import { LinkCard, CardGrid, LinkButton } from '@astrojs/starlight/components';
import { siteText, siteUrl, plain } from '../i18n/site';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const s = siteText(lang);
const t = Astro.locals.t;
---

<p class="lead">{plain(s('footer.tagline').replace(/&nbsp;/g, ' '))} {t('docs.home.lead')}</p>

<h2>{t('docs.sections')}</h2>
<CardGrid>
  <LinkCard title={t('nav.sip')} description={t('docs.sec.sip.desc')} href="sip-accounts/setup/" />
  <LinkCard title={t('nav.capture')} description={t('docs.sec.capture.desc')} href="external-recording/setup/" />
</CardGrid>

<h2>{t('docs.start')}</h2>
<p>{plain(s('dl.foot'))}</p>
<LinkButton href={siteUrl(lang, '', '#download')} icon="download" iconPlacement="start">
  {s('nav.download')}
</LinkButton>

<style>
  .lead {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }
</style>
