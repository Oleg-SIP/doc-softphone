---
/* A window of the program, photographed by the product itself in the
   reader's language and theme. The pictures are the ones ai-softphone.com
   shows (screenshots/<platform>/<language>/<theme>/<file>), taken for
   every language the phone speaks; a language without a set falls back to
   English. On disk Serbian in Latin letters is spelled the Qt way,
   `sr_Latn`. */
import { languages } from '../i18n/languages.mjs';
import { SITE } from '../i18n/site';

interface Props {
  /** file name under the language folder, e.g. `accounts.png` */
  name: string;
  alt: string;
  platform?: 'windows' | 'macos' | 'linux';
}
const { name, alt, platform = 'windows' } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const folder = (languages.some((l) => l.code === lang) ? lang : 'en').replace('-', '_');
const src = (theme: string) => `${SITE}/screenshots/${platform}/${folder}/${theme}/${name}`;
---

<figure class="shot">
  <img class="dark:sl-hidden" src={src('light')} alt={alt} loading="lazy" decoding="async" />
  <img class="light:sl-hidden" src={src('dark')} alt={alt} loading="lazy" decoding="async" />
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  .shot {
    margin-block: 1.5rem;
  }
  .shot img {
    max-width: min(100%, 38rem);
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
