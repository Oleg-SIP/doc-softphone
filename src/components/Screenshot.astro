---
/* A window of the program in the reader's language and theme.

   Two sources, looked up in this order:
   1. public/screenshots/<platform>/<language>/<theme>/<file> in this
      repository — windows the product site does not show, taken for the
      documentation (see tasks/screenshots-macos.md);
   2. the screenshots ai-softphone.com publishes, taken by the product
      itself for every language it speaks.
   A language without its own picture falls back to English, a theme
   without its own to light. Folders spell Serbian in Latin letters the
   Qt way, `sr_Latn`. */
import { existsSync } from 'node:fs';
import { SITE } from '../i18n/site';

interface Props {
  /** file name under the language folder, e.g. `accounts.png` */
  name: string;
  alt: string;
  platform?: 'windows' | 'macos' | 'linux';
}
const { name, alt, platform = 'windows' } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const folder = (code: string) => code.replace('-', '_');

function local(theme: string) {
  for (const code of [lang, 'en']) {
    for (const t of [theme, 'light']) {
      const path = `screenshots/${platform}/${folder(code)}/${t}/${name}`;
      if (existsSync(new URL(`../../public/${path}`, import.meta.url))) return `${base}/${path}`;
    }
  }
  return null;
}
const src = (theme: string) =>
  local(theme) ?? `${SITE}/screenshots/${platform}/${folder(lang)}/${theme}/${name}`;
---

<figure class="shot">
  <img class="dark:sl-hidden" src={src('light')} alt={alt} loading="lazy" decoding="async" />
  <img class="light:sl-hidden" src={src('dark')} alt={alt} loading="lazy" decoding="async" />
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  .shot {
    margin-block: 1.5rem;
  }
  .shot img {
    max-width: min(100%, 38rem);
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
